#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3


#define MOUSE_KEYS 4

// The LED strip hardware lives in the shield: the halves' strip in
// boards/shields/tp-sofle/boards/nice_nano_v2.overlay, the central's in
// tp-sofle_central.overlay (the central is a XIAO, different pins).

/*
 * Defines to enable/disable features
 *
 * These defines allow us to conditionally enable and disable parts of the keymap config.
 *
 * For example, if we decide to build the firmware without the mouse features, we can
 * disable all the config options that rely on those forks and modules without having
 * to edit the entire keymap file manually every time.
 */

#define HAS_MOUSE_KEYS

#ifdef HAS_MOUSE_KEYS
  #include <dt-bindings/zmk/mouse.h>
  #include <behaviors/mouse_keys.dtsi>
#endif  // HAS_MOUSE_KEYS



/ {
 macros {
        wleft: wleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>, <&macro_press &kp LCTRL>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LGUI>,<&macro_release &kp LCTRL>
                ;
        };
        wright: wright {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>, <&macro_press &kp LCTRL>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LGUI>,<&macro_release &kp LCTRL>
                ;
        };

        /*
         * Layer colour macros.
         *
         * ZMK can only CYCLE underglow effects, never select one, so the base
         * effect has to be known: SWIRL (effect 3). Breathe is effect 1, so
         * RGB_EFR twice steps 3 -> 2 -> 1 on press, and RGB_EFF twice steps
         * 1 -> 2 -> 3 back to swirl on release. Spectrum and swirl ignore the
         * hue, which is why the effect has to change for the colour to show.
         *
         * &rgb_ug is a global behaviour: the central runs these macros and ZMK
         * forwards each command to both halves, which is where the LEDs are.
         *
         * ADJUST (LOWER+RAISE) has no key of its own, so the second key is
         * bound per layer: the RAISE key ON the lower layer, and the LOWER key
         * ON the raise layer, both go purple and fall back to the first layer's
         * colour when released.
         */
        lower_c: lower_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo LOWER>
                , <&macro_tap &rgb_ug RGB_EFR &rgb_ug RGB_EFR &rgb_ug RGB_COLOR_HSB(120,100,100)>
                , <&macro_pause_for_release>
                , <&macro_release &mo LOWER>
                , <&macro_tap &rgb_ug RGB_EFF &rgb_ug RGB_EFF>
                ;
        };

        raise_c: raise_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo RAISE>
                , <&macro_tap &rgb_ug RGB_EFR &rgb_ug RGB_EFR &rgb_ug RGB_COLOR_HSB(240,100,100)>
                , <&macro_pause_for_release>
                , <&macro_release &mo RAISE>
                , <&macro_tap &rgb_ug RGB_EFF &rgb_ug RGB_EFF>
                ;
        };

        // RAISE key pressed while LOWER is held -> ADJUST, purple; back to green.
        adjust_from_lower: adjust_from_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo RAISE>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(285,100,100)>
                , <&macro_pause_for_release>
                , <&macro_release &mo RAISE>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(120,100,100)>
                ;
        };

        // LOWER key pressed while RAISE is held -> ADJUST, purple; back to blue.
        adjust_from_raise: adjust_from_raise {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo LOWER>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(285,100,100)>
                , <&macro_pause_for_release>
                , <&macro_release &mo LOWER>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,100)>
                ;
        };
    };

    behaviors {
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&wleft>, <&wright>;
        };
    };

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  DEL  |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
// |  TAB  |  A|afi  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   INS   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  PAUSE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| =  | +   | -  |
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp DELETE
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_PLAY_PAUSE  &kp LG(TAB)      &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp INS
                 &kp LGUI &kp LALT &kp LCTRL &lower_c   &kp RET    &kp SPACE  &raise_c   &kp EQUAL &kp PLUS  &kp MINUS
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rot_kp>;
        };

        lower_layer {
            display-name = "lower";
// TODO: Some binds are waiting for shifted keycode support.
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE &trans    &trans    &trans      &trans    &trans                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC  &kp RBRC   &trans &trans  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans     &trans &trans  &adjust_from_lower &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                | num0 | num1 | num2  | num3 | num4  | num5  |
// |OUT_BLE| INS  | PSCR | GUI   |       |      |                | PGUP | HOME |   ^   | END  | num6  | num7  |
// |OUT_USB| ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  | num8  | num9  |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |wleft |       |wright|       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3  &kp KP_N4 &kp KP_N5
&out OUT_BLE    &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &kp HOME  &kp UP    &kp END    &kp KP_N6 &kp KP_N6
&out OUT_USB    &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT  &kp KP_N8 &kp KP_N9
&trans          &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &trans    &wleft    &trans    &wright    &trans    &trans
                        &trans       &trans       &trans       &adjust_from_raise  &trans  &trans  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |       |       |      |       |        |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |  7   |   8   |   9   |      |       |        |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |  4   |   5   |   6   |      |       |        |
// | studio |         |         |         |         |         | RGB_TOG | |      |  1   |   2  |   3   |  0   |   .   |       |
//                    |         |         |         |         |         | |      | SPACE|      |   -   |      |
            display-name = "adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none          &none          &none        &none     &none      &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &kp KP_N7      &kp KP_N8      &kp KP_N9    &none     &none      &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &kp KP_N4      &kp KP_N5      &kp KP_N6    &none     &none      &none
&studio_unlock    &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N0 &kp KP_DOT &none
                                  &none           &none           &none           &trans           &none           &kp SPACE &trans &kp KP_MINUS &none &none
            >;

            // sensor-bindings = <&inc_dec_kp RGB_BRD RGB_BRI &inc_dec_kp RGB_SAD RGB_SAI>;
        };

#ifdef HAS_MOUSE_KEYS

    MouseKeys_layer {
      display-name = "MouseKeys";
// Auto-activated by trackball movement (see &zip_temp_layer in tp-sofle_central.overlay).
// Mouse buttons live on the LEFT thumb cluster, as on the Charybdis:
//   GUI: LCLK (drag)   ALT: MCLK   CTRL: RCLK   ENTER: MB4   (LOWER kept)
// Non-thumb keys deactivate this layer; all thumbs are excluded (excluded-positions).
            bindings = <
&trans &trans   &trans   &trans    &trans    &trans                             &trans    &trans    &trans   &trans   &trans &trans
&trans &trans   &trans   &trans    &trans    &trans                             &trans    &trans    &trans   &trans   &trans &trans
&trans &trans   &trans   &trans    &trans    &trans                             &trans    &trans    &trans   &trans   &trans &trans
&trans &trans   &trans   &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans   &trans   &trans &trans
                &mkp LCLK &mkp MCLK &mkp RCLK &trans    &mkp MB4      &trans    &trans    &trans    &trans   &trans
            >;
    };

#endif

    };
};
